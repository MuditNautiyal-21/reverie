# Reverie environment configuration
# Copy to .env and fill in real values.

# --- LLM ----------------------------------------------------------------
# Which LLM provider to use. Currently supported: groq
LLM_PROVIDER=groq

# Groq API key. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Model name for the configured provider.
# Groq default: llama-3.3-70b-versatile
LLM_MODEL=llama-3.3-70b-versatile

# --- Database -----------------------------------------------------------
# Supabase Postgres connection string.
# Use the "Session" pooler string from:
#   Supabase > Project Settings > Database > Connection string > URI
# Example:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Embeddings (optional overrides) ------------------------------------
# Defaults to sentence-transformers/all-MiniLM-L6-v2 (384-dim).
# If you change the model, also update EMBEDDING_DIM and re-run app.index.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384
